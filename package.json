{
  "name": "obsidian-claude-tutor",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "svelte-check --tsconfig ./tsconfig.json && node esbuild.config.mjs",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 . && node scripts/check-vault-listing.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-svelte": "3.23.1",
    "happy-dom": "20.14.6",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanikhawar/claude-tutor.git"
  }
}
